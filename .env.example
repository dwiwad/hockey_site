# =============================================================================
# HOCKEY DECODED - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to git - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS region where your S3 bucket is located
AWS_REGION=us-east-1

# AWS credentials for local development
# On ECS Fargate, these are provided automatically via IAM roles
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 bucket name for storing game data and depth scores
S3_BUCKET=hockey-decoded

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development, staging, or production
ENVIRONMENT=production

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional Overrides
# -----------------------------------------------------------------------------
# Override NHL season detection (uncomment to use)
# NHL_SEASON=2026